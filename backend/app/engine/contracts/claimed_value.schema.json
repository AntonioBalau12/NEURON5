{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qadna.co/hype-arena/schemas/v1/claimed_value.schema.json",
  "title": "Claimed value",
  "description": "A typed value a claim holds. op, when it is there, says how a stated value compares: \"over 10,000 customers\" is {\"kind\": \"quantity\", \"value\": 10000, \"unit\": \"customer\", \"op\": \"gt\"}. A form of the dataset may hold one; the values of an entry hold none.",
  "type": "object",
  "required": ["kind"],
  "properties": {
    "kind": {
      "enum": ["quantity", "money", "percent", "date", "version", "duration", "name", "boolean"]
    }
  },
  "allOf": [
    { "if": { "required": ["kind"], "properties": { "kind": { "const": "quantity" } } }, "then": { "$ref": "#/$defs/quantity" } },
    { "if": { "required": ["kind"], "properties": { "kind": { "const": "money" } } }, "then": { "$ref": "#/$defs/money" } },
    { "if": { "required": ["kind"], "properties": { "kind": { "const": "percent" } } }, "then": { "$ref": "#/$defs/percent" } },
    { "if": { "required": ["kind"], "properties": { "kind": { "const": "date" } } }, "then": { "$ref": "#/$defs/date" } },
    { "if": { "required": ["kind"], "properties": { "kind": { "const": "version" } } }, "then": { "$ref": "#/$defs/version" } },
    { "if": { "required": ["kind"], "properties": { "kind": { "const": "duration" } } }, "then": { "$ref": "#/$defs/duration" } },
    { "if": { "required": ["kind"], "properties": { "kind": { "const": "name" } } }, "then": { "$ref": "#/$defs/name" } },
    { "if": { "required": ["kind"], "properties": { "kind": { "const": "boolean" } } }, "then": { "$ref": "#/$defs/boolean" } }
  ],
  "$defs": {
    "op": {
      "description": "How the claim compares with its value: eq (the default), lt (under), le (up to), gt (over), ge (at least).",
      "enum": ["eq", "lt", "le", "gt", "ge"]
    },
    "unit": {
      "description": "A physical unit symbol from the published list (such as GB, mAh, mm, kg), or a counted noun in the singular (such as language, customer, employee). Time units belong to the duration kind.",
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
      "maxLength": 40,
      "not": { "$ref": "#/$defs/duration_unit" }
    },
    "duration_unit": {
      "enum": ["ms", "s", "min", "h", "day", "week", "month", "year"]
    },
    "currency": {
      "description": "An ISO 4217 code, such as EUR or USD.",
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "period": {
      "description": "The billing period of a recurring price. Absent for a one-off price.",
      "enum": ["day", "week", "month", "year"]
    },
    "partial_date": {
      "description": "A date as precise as the claim: 2026, 2026-03 or 2026-03-12.",
      "type": "string",
      "pattern": "^[0-9]{4}(-(0[1-9]|1[0-2])(-(0[1-9]|[12][0-9]|3[01]))?)?$"
    },

    "quantity": {
      "description": "A number with a unit: 128 GB, 40 languages, 10,000 customers.",
      "type": "object",
      "required": ["kind", "value", "unit"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "quantity" },
        "value": { "type": "number" },
        "unit": { "$ref": "#/$defs/unit" },
        "op": { "$ref": "#/$defs/op" }
      }
    },
    "money": {
      "description": "A price: €49 a month is {\"value\": 49, \"currency\": \"EUR\", \"per\": \"month\"}.",
      "type": "object",
      "required": ["kind", "value", "currency"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "money" },
        "value": { "type": "number", "minimum": 0 },
        "currency": { "$ref": "#/$defs/currency" },
        "per": { "$ref": "#/$defs/period" },
        "op": { "$ref": "#/$defs/op" }
      }
    },
    "percent": {
      "description": "A percentage: 99.9% is {\"value\": 99.9}.",
      "type": "object",
      "required": ["kind", "value"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "percent" },
        "value": { "type": "number" },
        "op": { "$ref": "#/$defs/op" }
      }
    },
    "date": {
      "description": "A date, at the precision the claim states it.",
      "type": "object",
      "required": ["kind", "value"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "date" },
        "value": { "$ref": "#/$defs/partial_date" },
        "op": { "$ref": "#/$defs/op" }
      }
    },
    "version": {
      "description": "A version number without its v: v2.3 is {\"value\": \"2.3\"}.",
      "type": "object",
      "required": ["kind", "value"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "version" },
        "value": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+){0,3}$" },
        "op": { "$ref": "#/$defs/op" }
      }
    },
    "duration": {
      "description": "A length of time: two weeks is {\"value\": 2, \"unit\": \"week\"}, and equals 14 days.",
      "type": "object",
      "required": ["kind", "value", "unit"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "duration" },
        "value": { "type": "number", "minimum": 0 },
        "unit": { "$ref": "#/$defs/duration_unit" },
        "op": { "$ref": "#/$defs/op" }
      }
    },
    "name": {
      "description": "A name from the universe: a person, product, company or place. Any of its published spellings matches.",
      "type": "object",
      "required": ["kind", "value"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "name" },
        "value": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "\\S" }
      }
    },
    "boolean": {
      "description": "Yes or no about a recorded event: \"Hooly passed its SOC 2 audit\" is {\"value\": true}.",
      "type": "object",
      "required": ["kind", "value"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "boolean" },
        "value": { "type": "boolean" }
      }
    }
  }
}
